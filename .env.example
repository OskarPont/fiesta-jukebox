# Copia este archivo a .env y rellénalo. Nunca subas tu .env a ningún sitio.

# Clave para entrar al panel de administración (mínimo 12 caracteres; mejor 32+).
# Genera una con: openssl rand -base64 32
ADMIN_KEY=

# Secreto para firmar las cookies (mínimo 16 caracteres; mejor 32+). Distinto de ADMIN_KEY.
# Cambiarlo cierra todas las sesiones de administrador abiertas.
COOKIE_SECRET=

# URL pública con la que entran los invitados, con HTTPS y sin barra final.
PUBLIC_URL=https://tu-dominio.com/fiesta
BASE_PATH=/fiesta
PORT=3000

# IP o subred del proxy inverso que tienes delante (para leer la IP real de los clientes).
# Vacío = solo redes locales y privadas (vale para un proxy en la misma máquina o en Docker).
# No pongas "true": permitiría que cualquiera falsee su IP y se salte los límites de intentos.
TRUST_PROXY=

# Mercado de Spotify para las búsquedas (código de país ISO).
SPOTIFY_MARKET=ES

# 1 = Spotify simulado, para probar sin cuenta ni Premium. 0 en producción.
SPOTIFY_MOCK=0
TZ=Europe/Madrid
